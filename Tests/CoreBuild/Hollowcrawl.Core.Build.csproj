<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless compile of the engine-free Core assembly (Assets/_Project/Scripts/Core), mirroring Unity's
    constraints: .NET Standard 2.1 API surface and C# 9. Lets CI and cloud sessions build and test
    the gameplay core without the Unity editor. Not used by Unity itself.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Hollowcrawl.Core</AssemblyName>
    <RootNamespace>Hollowcrawl</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Scripts/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
